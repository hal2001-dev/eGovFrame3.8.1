<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:jdbc="http://www.springframework.org/schema/jdbc"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/jdbc
		http://www.springframework.org/schema/jdbc/spring-jdbc.xsd
		http://www.springframework.org/schema/context
		http://www.springframework.org/schema/context/spring-context.xsd">

	<!-- ============================================================= -->
	<!-- 기본(hsql) 프로파일: HSQLDB 인메모리 (외부 DB 없이 오프라인 구동)      -->
	<!-- 활성 프로파일을 지정하지 않으면 이 프로파일이 사용됩니다               -->
	<!-- (web.xml 의 spring.profiles.default=hsql 참고).                   -->
	<!-- ============================================================= -->
	<beans profile="hsql">
		<bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
			<property name="driverClassName" value="org.hsqldb.jdbcDriver" />
			<property name="url" value="jdbc:hsqldb:mem:sampledb" />
			<property name="username" value="sa" />
			<property name="password" value="" />
		</bean>

		<!-- 기동 시 스키마 생성 + 시드 데이터 적재 (HSQLDB 전용) -->
		<jdbc:initialize-database data-source="dataSource" ignore-failures="DROPS">
			<jdbc:script location="classpath:db/schema-hsql.sql" />
			<jdbc:script location="classpath:db/data-hsql.sql" />
		</jdbc:initialize-database>
	</beans>

	<!-- ============================================================= -->
	<!-- oracle 프로파일: -Dspring.profiles.active=oracle 로 기동            -->
	<!-- 접속정보는 classpath:oracle.properties 에서 읽습니다.               -->
	<!-- 여기서는 DDL 을 자동 실행하지 않습니다(운영 DB 보호):               -->
	<!-- 사전에 db/oracle/*.sql 을 직접 실행하세요.                         -->
	<!-- ============================================================= -->
	<beans profile="oracle">
		<context:property-placeholder location="classpath:oracle.properties"
			ignore-resource-not-found="false" />

		<bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
			<property name="driverClassName" value="${oracle.driverClassName}" />
			<property name="url" value="${oracle.url}" />
			<property name="username" value="${oracle.username}" />
			<property name="password" value="${oracle.password}" />
			<property name="initialSize" value="${oracle.pool.initialSize}" />
			<property name="maxActive" value="${oracle.pool.maxActive}" />
			<property name="maxIdle" value="${oracle.pool.maxIdle}" />
			<property name="validationQuery" value="SELECT 1 FROM DUAL" />
			<property name="testOnBorrow" value="true" />
		</bean>
	</beans>

</beans>
