<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
		http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	version="3.1">

	<display-name>egovframe-sample</display-name>

	<!-- 루트 애플리케이션 컨텍스트: 서비스, 데이터소스, MyBatis, 트랜잭션 등 -->
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>classpath*:egovframework/spring/context-*.xml</param-value>
	</context-param>

	<!-- DB 선택: 기본은 HSQLDB(오프라인 샘플). Oracle 로 띄우려면
	     -Dspring.profiles.active=oracle 로 이 기본값을 덮어쓴다. -->
	<context-param>
		<param-name>spring.profiles.default</param-name>
		<param-value>hsql</param-value>
	</context-param>

	<!-- 스프링 루트 컨텍스트를 기동하는 리스너 -->
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>

	<!-- 요청 인코딩을 UTF-8 로 강제(한글 깨짐 방지) -->
	<filter>
		<filter-name>encodingFilter</filter-name>
		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
		<init-param>
			<param-name>forceEncoding</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>encodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- 웹(화면) 전용 공통 필터 : /action/* 요청에만 동작 (REST 는 관여 안 함) -->
	<filter>
		<filter-name>webCommonFilter</filter-name>
		<filter-class>egovframework.example.cmm.web.WebCommonFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>webCommonFilter</filter-name>
		<url-pattern>/action/*</url-pattern>
	</filter-mapping>

	<!-- REST API(/api/*) 보호용 HMAC 인증 필터 (서버-투-서버) -->
	<filter>
		<filter-name>hmacAuthFilter</filter-name>
		<filter-class>egovframework.example.cmm.security.HmacAuthFilter</filter-class>
		<init-param>
			<param-name>configLocation</param-name>
			<param-value>hmac.properties</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>hmacAuthFilter</filter-name>
		<url-pattern>/api/*</url-pattern>
	</filter-mapping>

	<!-- 스프링 MVC 디스패처 서블릿 (컨트롤러 컨텍스트를 별도 로딩) -->
	<servlet>
		<servlet-name>action</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>classpath*:egovframework/spring/springmvc/dispatcher-servlet.xml</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>action</servlet-name>
		<url-pattern>/</url-pattern>
	</servlet-mapping>

	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

</web-app>
